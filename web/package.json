{
  "name": "privatebin-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-dist --log-level=warning && node --test .test-dist/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "qrcode-generator": "^2.0.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
